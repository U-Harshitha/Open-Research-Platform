# AI for drafting, review and summaries — free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Real papers for Find — free key at https://openalex.org/settings/api
# ($1/day of free usage ≈ 1,000 searches; works without a key at a much lower limit)
OPENALEX_API_KEY=

# Optional alternative to Groq: set this instead and `pip install google-genai`
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Browser origins allowed to call this API (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Firebase Admin, only used to log searches.
FIREBASE_PROJECT_ID=research-e9734
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

FLASK_ENV=development
