# Gemini API key — create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to Google's rolling alias for the current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Browser origins allowed to call this API (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Firebase Admin, only used to log searches.
FIREBASE_PROJECT_ID=research-e9734
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

FLASK_ENV=development
