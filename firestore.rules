rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isDocumentOwner(docData) {
      return isAuthenticated() && request.auth.uid == docData.createdBy;
    }
    
    function isCollaborator(docData) {
      return isAuthenticated() && request.auth.uid in docData.collaborators;
    }
    
    function isPublicDocument(docData) {
      return docData.isPublic == true;
    }
    
    // Documents collection
    match /documents/{documentId} {
      // Allow read if user is authenticated and either:
      // - Is a collaborator on the document
      // - Document is public
      allow read: if isAuthenticated() && (
        isCollaborator(resource.data) || 
        isPublicDocument(resource.data)
      );
      
      // Allow create if user is authenticated and includes themselves as collaborator
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.collaborators &&
        request.resource.data.createdBy == request.auth.uid;
      
      // Allow update if user is a collaborator
      allow update: if isAuthenticated() && isCollaborator(resource.data);
      
      // Allow delete only if user is the document owner
      allow delete: if isAuthenticated() && isDocumentOwner(resource.data);
    }
    
    // User presence for real-time collaboration
    match /presence/{presenceId} {
      allow read, write: if isAuthenticated();
      // Auto-delete stale presence records after 5 minutes
      allow delete: if isAuthenticated();
    }
    
    // Comments on documents
    match /comments/{commentId} {
      // Allow read if user can read the associated document
      allow read: if isAuthenticated() && 
        exists(/databases/$(database)/documents/documents/$(resource.data.docId)) &&
        (isCollaborator(get(/databases/$(database)/documents/documents/$(resource.data.docId)).data) ||
         isPublicDocument(get(/databases/$(database)/documents/documents/$(resource.data.docId)).data));
      
      // Allow create if user can access the document and is the comment author
      allow create: if isAuthenticated() && 
        exists(/databases/$(database)/documents/documents/$(request.resource.data.docId)) &&
        isCollaborator(get(/databases/$(database)/documents/documents/$(request.resource.data.docId)).data) &&
        request.resource.data.userId == request.auth.uid;
      
      // Allow update/delete if user is the comment author
      allow update, delete: if isAuthenticated() && 
        request.auth.uid == resource.data.userId;
    }
    
    // Files uploaded to a document (metadata; bytes live in Storage)
    match /documentFiles/{fileId} {
      function parentDoc(docId) {
        return get(/databases/$(database)/documents/documents/$(docId)).data;
      }
      allow read: if isAuthenticated() &&
        (isCollaborator(parentDoc(resource.data.documentId)) || isPublicDocument(parentDoc(resource.data.documentId)));
      allow create: if isAuthenticated() &&
        request.resource.data.uploadedBy == request.auth.uid &&
        isCollaborator(parentDoc(request.resource.data.documentId));
      allow delete: if isAuthenticated() && resource.data.uploadedBy == request.auth.uid;
    }

    // Analytics - users can only create and read their own analytics
    match /analytics/{analyticsId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Search logs - allow authenticated users to create only (for rate limiting)
    match /search_logs/{logId} {
      allow create: if isAuthenticated();
    }
    
    // Asset analyses - allow authenticated users to create and read their own
    match /asset_analyses/{analysisId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // User profiles (optional for future use)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}